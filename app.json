{
  "expo": {
    "name": "Catch",
    "slug": "catch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catch",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bstanford4.catch",
      "icon": "./assets/expo.icon",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bstanford4.catch",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Catch uses your selected photos to show sporting equipment on your profile.",
          "cameraPermission": "Catch uses the camera when you choose to photograph sporting equipment.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F26B3A",
          "defaultChannel": "catch-updates",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
